# Lifecycle Tracker — Environment Configuration
# Copy this to .env and fill in your values

# API key for programmatic access (MCP, curl, etc.)
# Leave empty to disable API key auth (not recommended for production)
# Generate one with: openssl rand -hex 16
API_KEY=

# Origin URL for SvelteKit CSRF protection
# Set this to your actual domain/IP when deploying
ORIGIN=http://localhost

# Port overrides (defaults shown)
# CADDY_HTTPS_PORT=443
# CADDY_HTTP_PORT=80
